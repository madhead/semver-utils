{
  "name": "semver-utils",
  "version": "5.1.1",
  "private": true,
  "description": "One-stop shop for working with semantic versions in your workflows",
  "main": "lib/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madhead/semver-utils.git"
  },
  "keywords": [
    "actions",
    "github actions",
    "semver",
    "utils"
  ],
  "author": "madhead <siarhei.krukau@gmail.com> (https://madhead.me)",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.2",
    "js-yaml": "^5.5.0",
    "prettier": "3.9.10",
    "tmp": "^0.2.7",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
